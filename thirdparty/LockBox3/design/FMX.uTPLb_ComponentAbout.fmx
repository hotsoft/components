              'see the MPL License for the specific language governing rights a' +
              'nd '
            'limitations'
            'under the License.'
            ''
            
              'The Initial Developer of the Original Code for TurboPower LockBo' +
              'x version 2'
            'and earlier was TurboPower Software.'
            '')
          ReadOnly = True
        end
